After=network.target

[Service]
WorkingDirectory=/var/www/saodem/api
ExecStart=/usr/bin/dotnet /var/www/saodem/api/HoltelCentrel.Api.dll
Restart=always
RestartSec=5
Environment=ASPNETCORE_ENVIRONMENT=Production
