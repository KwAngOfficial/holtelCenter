# Nginx — Sao Dem Holtel
# Copy → /etc/nginx/sites-available/saodem
# Sửa YOUR_DOMAIN trước khi dùng

server {
    listen 80;
    server_name YOUR_DOMAIN www.YOUR_DOMAIN;

    # Certbot sẽ thêm SSL sau: certbot --nginx -d YOUR_DOMAIN -d www.YOUR_DOMAIN

    root /var/www/saodem/web;
    index index.html;

    # API → backend nội bộ
    location /api/ {
        proxy_pass http://127.0.0.1:5161/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # React SPA
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /config.js {
        add_header Cache-Control "no-cache";
    }
}
